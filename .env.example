# Copia este fichero como .env y rellena SOLO la clave del proveedor que uses.
# El .env real nunca se sube a GitHub (está en .gitignore).

# --- Proveedor de IA: groq | anthropic | openai | gemini | plantillas ---
# "plantillas" no usa IA: textos fijos según la puntuación, sin coste.
LLM_PROVIDER=groq
# Vacío = modelo por defecto del proveedor (ver prismahr/config.py)
LLM_MODEL=

# --- Claves (rellena la que corresponda) ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Opcional ---
# LLM_CONCURRENCY=4          # personas procesadas a la vez
# LLM_MAX_TOKENS=4000
# DATOS_JSON=datos/ejemplo.json
# OUTPUT_DIR=salida
# FIRMA_IMAGE=assets/firma.png
# CHROMIUM_PATH=             # solo si usas un Chromium ya instalado
